{
  "name": "money-tracker",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "description": "Money tracker by Zestera - Vite + TypeScript module build of the single-file app",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "e2e:legacy": "node e2e/run.cjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "buildDate": "2026-10-30"
}
